<div class="content">

  <!-- Header -->
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
    <div>
      <h2 style="margin:0; font-size:24px; color:#1a1a2e;">Mantenimiento de Usuarios</h2>
      <small style="color:#888;">Gestión y administración de usuarios del sistema</small>
    </div>
    <a href="/admin/register" style="background:#03a7ff; color:white; padding:10px 20px; border-radius:8px; text-decoration:none; font-weight:600; display:flex; align-items:center; gap:8px;">
      <i class="fa-solid fa-user-plus"></i> Registrar Usuario
    </a>
  </div>

  <!-- Alerta éxito -->
  <% if (successMessage) { %>
  <div style="background:#d4edda; border:1px solid #c3e6cb; color:#155724; padding:12px 16px; border-radius:8px; margin-bottom:20px; display:flex; align-items:center; gap:8px;">
    <i class="fa-solid fa-circle-check"></i> <%= successMessage %>
  </div>
  <% } %>

  <!-- Tarjetas resumen -->
  <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:28px;">
    <div style="background:white; border-radius:12px; padding:20px; box-shadow:0 2px 8px rgba(0,0,0,.08); display:flex; align-items:center; gap:16px;">
      <div style="background:#e8f4ff; border-radius:10px; padding:14px;">
        <i class="fa-solid fa-users" style="color:#03a7ff; font-size:22px;"></i>
      </div>
      <div>
        <div style="color:#888; font-size:13px;">Total Usuarios</div>
        <div style="font-size:28px; font-weight:700; color:#1a1a2e;"><%= usuarios.length %></div>
      </div>
    </div>
    <div style="background:white; border-radius:12px; padding:20px; box-shadow:0 2px 8px rgba(0,0,0,.08); display:flex; align-items:center; gap:16px;">
      <div style="background:#ffeaea; border-radius:10px; padding:14px;">
        <i class="fa-solid fa-shield-halved" style="color:#e74c3c; font-size:22px;"></i>
      </div>
      <div>
        <div style="color:#888; font-size:13px;">Administradores</div>
        <div style="font-size:28px; font-weight:700; color:#1a1a2e;"><%= usuarios.filter(u => u.role === 'admin').length %></div>
      </div>
    </div>
    <div style="background:white; border-radius:12px; padding:20px; box-shadow:0 2px 8px rgba(0,0,0,.08); display:flex; align-items:center; gap:16px;">
      <div style="background:#fff8e1; border-radius:10px; padding:14px;">
        <i class="fa-solid fa-briefcase" style="color:#f39c12; font-size:22px;"></i>
      </div>
      <div>
        <div style="color:#888; font-size:13px;">Trabajadores</div>
        <div style="font-size:28px; font-weight:700; color:#1a1a2e;"><%= usuarios.filter(u => u.role === 'trabajador').length %></div>
      </div>
    </div>
    <div style="background:white; border-radius:12px; padding:20px; box-shadow:0 2px 8px rgba(0,0,0,.08); display:flex; align-items:center; gap:16px;">
      <div style="background:#e8faf0; border-radius:10px; padding:14px;">
        <i class="fa-solid fa-person" style="color:#27ae60; font-size:22px;"></i>
      </div>
      <div>
        <div style="color:#888; font-size:13px;">Clientes</div>
        <div style="font-size:28px; font-weight:700; color:#1a1a2e;"><%= usuarios.filter(u => u.role === 'cliente').length %></div>
      </div>
    </div>
  </div>

  <!-- Tabla -->
  <div style="background:white; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,.08); overflow:hidden;">
    <div style="padding:20px 24px; border-bottom:1px solid #f0f0f0; display:flex; justify-content:space-between; align-items:center;">
      <h5 style="margin:0; font-size:17px; font-weight:600;">Lista de Usuarios</h5>
      <input type="text" id="buscador" placeholder="&#xf002;  Buscar..."
        style="border:1px solid #e0e0e0; border-radius:8px; padding:8px 14px; font-size:14px; outline:none; width:220px;"
        oninput="filtrar(this.value)">
    </div>
    <table style="width:100%; border-collapse:collapse;" id="tablaUsuarios">
      <thead>
        <tr style="background:#f8f9fa;">
          <th style="padding:14px 24px; text-align:left; font-size:13px; color:#888; font-weight:600; text-transform:uppercase; letter-spacing:.5px;">Usuario</th>
          <th style="padding:14px 16px; text-align:left; font-size:13px; color:#888; font-weight:600; text-transform:uppercase; letter-spacing:.5px;">Email</th>
          <th style="padding:14px 16px; text-align:left; font-size:13px; color:#888; font-weight:600; text-transform:uppercase; letter-spacing:.5px;">Rol</th>
          <th style="padding:14px 16px; text-align:left; font-size:13px; color:#888; font-weight:600; text-transform:uppercase; letter-spacing:.5px;">Estado</th>
          <th style="padding:14px 16px; text-align:center; font-size:13px; color:#888; font-weight:600; text-transform:uppercase; letter-spacing:.5px;">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% usuarios.forEach(usuario => { %>
        <tr style="border-top:1px solid #f0f0f0; transition:.2s;" onmouseover="this.style.background='#fafafa'" onmouseout="this.style.background='white'">
          <td style="padding:16px 24px; font-weight:600; color:#1a1a2e;">
            <div style="display:flex; align-items:center; gap:10px;">
              <div style="width:36px; height:36px; border-radius:50%; background:#03a7ff; color:white; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:14px;">
                <%= usuario.userid.charAt(0).toUpperCase() %>
              </div>
              <%= usuario.userid %>
            </div>
          </td>
          <td style="padding:16px; color:#666;"><%= usuario.email %></td>
          <td style="padding:16px;">
            <% if(usuario.role === 'admin') { %>
              <span style="background:#ffeaea; color:#e74c3c; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">Admin</span>
            <% } else if(usuario.role === 'trabajador') { %>
              <span style="background:#fff8e1; color:#f39c12; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">Trabajador</span>
            <% } else { %>
              <span style="background:#e8faf0; color:#27ae60; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">Cliente</span>
            <% } %>
          </td>
          <td style="padding:16px;">
            <% if(usuario.activo === 1) { %>
              <span style="display:flex; align-items:center; gap:6px; color:#27ae60; font-size:13px;">
                <span style="width:8px; height:8px; background:#27ae60; border-radius:50%; display:inline-block;"></span> Activo
              </span>
            <% } else { %>
              <span style="display:flex; align-items:center; gap:6px; color:#999; font-size:13px;">
                <span style="width:8px; height:8px; background:#ccc; border-radius:50%; display:inline-block;"></span> Inactivo
              </span>
            <% } %>
          </td>
          <td style="padding:16px; text-align:center;">
            <a href="/admin/ver/datos/<%= usuario.id %>"
               style="background:#e8f4ff; color:#03a7ff; border:none; padding:7px 14px; border-radius:6px; font-size:13px; font-weight:600; text-decoration:none; margin-right:6px; display:inline-flex; align-items:center; gap:5px;">
              <i class="fa-solid fa-eye"></i> Ver
            </a>
            <a href="/user-roles/delete/<%= usuario.id %>"
               onclick="return confirm('¿Eliminar al usuario <%= usuario.userid %>?')"
               style="background:#ffeaea; color:#e74c3c; border:none; padding:7px 14px; border-radius:6px; font-size:13px; font-weight:600; text-decoration:none; display:inline-flex; align-items:center; gap:5px;">
              <i class="fa-solid fa-trash"></i> Eliminar
            </a>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <% if(usuarios.length === 0) { %>
    <div style="text-align:center; padding:48px; color:#aaa;">
      <i class="fa-solid fa-users-slash" style="font-size:40px; margin-bottom:12px; display:block;"></i>
      No hay usuarios registrados.
    </div>
    <% } %>
  </div>
</div>

<script>
function filtrar(val) {
  val = val.toLowerCase();
  document.querySelectorAll('#tablaUsuarios tbody tr').forEach(function(row) {
    row.style.display = row.textContent.toLowerCase().includes(val) ? '' : 'none';
  });
}
</script>
