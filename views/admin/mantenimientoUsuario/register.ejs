<div class="content">
  <div class="page-header">
    <div>
      <h2>Registrar Usuario</h2>
      <small>Crear una nueva cuenta en el sistema</small>
    </div>
    <a href="/admin/mantenimientoUsu" class="btn-secondary-panel">
      <i class="fa-solid fa-arrow-left"></i> Regresar
    </a>
  </div>

  <% if (successMessage) { %>
  <div class="alert-success-panel"><i class="fa-solid fa-circle-check"></i> <%= successMessage %></div>
  <% } %>

  <div class="panel-card" style="max-width:680px;">
    <div class="panel-card-header">
      <h5><i class="fa-solid fa-user-plus" style="color:#03a7ff; margin-right:8px;"></i>Datos del Usuario</h5>
    </div>
    <div class="panel-card-body">
      <form action="/user-roles" method="POST">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0 20px;">
          <div class="form-group">
            <label>Rol</label>
            <select name="role" required>
              <option value="cliente">Cliente</option>
              <option value="trabajador">Trabajador</option>
              <option value="admin">Administrador</option>
            </select>
          </div>
          <div class="form-group">
            <label>Estado</label>
            <select name="activo" required>
              <option value="1">Activo</option>
              <option value="0">Inactivo</option>
            </select>
          </div>
          <div class="form-group">
            <label>Usuario (ID de acceso)</label>
            <input type="text" name="userid" required placeholder="ej: juan.perez">
          </div>
          <div class="form-group">
            <label>Correo Electrónico</label>
            <input type="email" name="email" required placeholder="correo@ejemplo.com">
          </div>
          <div class="form-group" style="grid-column:1/-1;">
            <label>Nombre Completo</label>
            <input type="text" name="name" required placeholder="Nombre y apellidos">
          </div>
          <div class="form-group">
            <label>DNI / RUC</label>
            <input type="number" name="Identity" required min="0" placeholder="00000000">
          </div>
          <div class="form-group">
            <label>Teléfono</label>
            <input type="text" name="telf" required pattern="[0-9]+" placeholder="987654321">
          </div>
          <div class="form-group" style="grid-column:1/-1;">
            <label>Contraseña</label>
            <input type="password" name="password" required placeholder="Mínimo 8 caracteres">
          </div>
        </div>
        <button type="submit" class="btn-primary-panel" style="width:100%; justify-content:center; padding:13px;">
          <i class="fa-solid fa-user-plus"></i> Registrar Usuario
        </button>
      </form>
    </div>
  </div>
</div>
