<div class="content">
  <div class="page-header">
    <div>
      <h2>Registrar Blog</h2>
      <small>Publica un nuevo artículo en el blog</small>
    </div>
    <a href="/admin/blog" class="btn-secondary-panel">
      <i class="fa-solid fa-arrow-left"></i> Regresar
    </a>
  </div>

  <div class="panel-card" style="max-width:720px;">
    <div class="panel-card-header">
      <h5><i class="fa-solid fa-blog" style="color:#27ae60; margin-right:8px;"></i>Datos del Blog</h5>
    </div>
    <div class="panel-card-body">
      <form enctype="multipart/form-data" action="/blogs" method="POST">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0 20px;">
          <div class="form-group" style="grid-column:1/-1;">
            <label>Título</label>
            <input type="text" name="titulo" required placeholder="Título del artículo">
          </div>
          <div class="form-group">
            <label>Fecha</label>
            <input type="date" name="fecha" required>
          </div>
          <div class="form-group">
            <label>Categoría</label>
            <select name="categoria" required>
              <option value="">Seleccionar...</option>
              <option value="Conciliación">Conciliación</option>
              <option value="Arbitraje">Arbitraje</option>
              <option value="Legal">Legal</option>
              <option value="Opinión">Opinión</option>
              <option value="Noticias">Noticias</option>
            </select>
          </div>
          <div class="form-group" style="grid-column:1/-1;">
            <label>Descripción</label>
            <textarea name="descripcion" rows="6" required placeholder="Contenido del artículo..."></textarea>
          </div>
          <div class="form-group" style="grid-column:1/-1;">
            <label>Imagen <span style="color:#999; font-weight:400; font-size:11px;">(JPG o PNG, máx. 10MB)</span></label>
            <input type="file" name="imagen" accept="image/jpeg,image/png">
          </div>
        </div>
        <button type="submit" class="btn-primary-panel" style="width:100%; justify-content:center; padding:13px; background:#27ae60;">
          <i class="fa-solid fa-plus"></i> Publicar Blog
        </button>
      </form>
    </div>
  </div>
</div>
