<div class="content">
  <div class="page-header">
    <div>
      <h2>Registrar Evento</h2>
      <small>Publica un nuevo evento en el sitio</small>
    </div>
    <a href="/admin/eventos" class="btn-secondary-panel">
      <i class="fa-solid fa-arrow-left"></i> Regresar
    </a>
  </div>

  <div class="panel-card" style="max-width:720px;">
    <div class="panel-card-header">
      <h5><i class="fa-solid fa-calendar-days" style="color:#f39c12; margin-right:8px;"></i>Datos del Evento</h5>
    </div>
    <div class="panel-card-body">
      <form enctype="multipart/form-data" action="/eventos" method="POST">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0 20px;">
          <div class="form-group" style="grid-column:1/-1;">
            <label>Título</label>
            <input type="text" name="titulo" required placeholder="Título del evento">
          </div>
          <div class="form-group" style="grid-column:1/-1;">
            <label>Ponentes</label>
            <input type="text" name="ponentes" required placeholder="Nombre de los ponentes">
          </div>
          <div class="form-group">
            <label>Fecha</label>
            <input type="date" name="fecha" required>
          </div>
          <div class="form-group">
            <label>Categoría</label>
            <select name="categoria" required>
              <option value="">Seleccionar...</option>
              <option value="Conciliación">Conciliación</option>
              <option value="Arbitraje">Arbitraje</option>
              <option value="Seminario">Seminario</option>
              <option value="Taller">Taller</option>
              <option value="Conferencia">Conferencia</option>
            </select>
          </div>
          <div class="form-group" style="grid-column:1/-1;">
            <label>Descripción</label>
            <textarea name="descripcion" rows="4" required placeholder="Descripción del evento..."></textarea>
          </div>
          <div class="form-group" style="grid-column:1/-1;">
            <label>Dirección / Lugar</label>
            <input type="text" name="calle" required placeholder="Jr. La Mar 493, Cajamarca">
          </div>
          <div class="form-group">
            <label>Documento <span style="color:#999; font-weight:400; font-size:11px;">(PDF, DOC)</span></label>
            <input type="file" name="documentos" accept=".pdf,.doc,.docx">
          </div>
          <div class="form-group">
            <label>Imagen <span style="color:#999; font-weight:400; font-size:11px;">(JPG o PNG)</span></label>
            <input type="file" name="imagen" accept="image/jpeg,image/png">
          </div>
        </div>
        <input type="hidden" name="lat" value="0">
        <input type="hidden" name="lng" value="0">
        <button type="submit" class="btn-primary-panel" style="width:100%; justify-content:center; padding:13px; background:#f39c12;">
          <i class="fa-solid fa-plus"></i> Publicar Evento
        </button>
      </form>
    </div>
  </div>
</div>
