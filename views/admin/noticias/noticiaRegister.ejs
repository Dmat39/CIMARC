<div class="content">
  <div class="page-header">
    <div>
      <h2>Registrar Noticia</h2>
      <small>Publica una nueva noticia en el sitio</small>
    </div>
    <a href="/admin/noticias" class="btn-secondary-panel">
      <i class="fa-solid fa-arrow-left"></i> Regresar
    </a>
  </div>

  <div class="panel-card" style="max-width:720px;">
    <div class="panel-card-header">
      <h5><i class="fa-solid fa-newspaper" style="color:#e74c3c; margin-right:8px;"></i>Datos de la Noticia</h5>
    </div>
    <div class="panel-card-body">
      <form enctype="multipart/form-data" action="/noticias" method="POST">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0 20px;">
          <div class="form-group" style="grid-column:1/-1;">
            <label>Título</label>
            <input type="text" name="titulo" required placeholder="Título de la noticia">
          </div>
          <div class="form-group">
            <label>Fecha</label>
            <input type="date" name="fecha" required>
          </div>
          <div class="form-group">
            <label>Categoría</label>
            <select name="categoria" required>
              <option value="">Seleccionar...</option>
              <option value="Conciliación">Conciliación</option>
              <option value="Arbitraje">Arbitraje</option>
              <option value="Institucional">Institucional</option>
              <option value="Legal">Legal</option>
              <option value="Eventos">Eventos</option>
            </select>
          </div>
          <div class="form-group" style="grid-column:1/-1;">
            <label>Descripción</label>
            <textarea name="descripcion" rows="5" required placeholder="Contenido de la noticia..."></textarea>
          </div>
          <div class="form-group" style="grid-column:1/-1;">
            <label>Imagen <span style="color:#999; font-weight:400; font-size:11px;">(JPG o PNG)</span></label>
            <input type="file" name="imagen" accept="image/jpeg,image/png">
          </div>
        </div>
        <button type="submit" class="btn-primary-panel" style="width:100%; justify-content:center; padding:13px; background:#e74c3c;">
          <i class="fa-solid fa-plus"></i> Publicar Noticia
        </button>
      </form>
    </div>
  </div>
</div>
