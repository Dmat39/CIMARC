<div id="content">
  <div class="blog-list style-detail mt-100">
    <div class="container">
      <div class="row flex-center">
        <div class="col-12 col-lg-8">
          <div class="blog-paragraph">
            <div class="paragraph-heading">
              <a class="caption2 pt-8 pb-8 pl-16 pr-16 bg-surface bora-20 hover-button-black" href="/eventos">
                ← Volver a Eventos
              </a>
              <div class="heading4 mt-16"><%- evento.titulo %></div>
              <div class="bg-img mt-20" style="height:380px; overflow:hidden; border-radius:12px;">
                <img src="<%= evento.imagen %>" alt="<%= evento.titulo %>" style="width:100%; height:100%; object-fit:cover;"/>
              </div>
              <div class="date flex-item-center gap-16 mt-16">
                <div class="author caption2 text-secondary">by <span class="text-on-surface"><%= evento.user.email %></span></div>
                <div class="item-date flex-item-center">
                  <i class="ph-bold ph-calendar-blank"></i>
                  <span class="ml-4 caption2"><%= evento.fecha %></span>
                </div>
              </div>
            </div>

            <div class="mt-32">
              <h4 class="heading6">Descripción</h4>
              <p class="body2 text-secondary mt-16" style="line-height:1.8; text-align:justify;">
                <%- evento.descripcion %>
              </p>
            </div>

            <div class="mt-32">
              <h4 class="heading6">Ponentes</h4>
              <ul style="list-style:none; padding:0; margin-top:12px;">
                <% evento.ponentes.split('\n').forEach(function(ponente) { %>
                <li class="body2 text-secondary" style="padding:8px 0; border-bottom:1px solid #f0f0f0;">
                  <i class="ph ph-user" style="color:#03a7ff; margin-right:8px;"></i>
                  <%- ponente.trim() %>
                </li>
                <% }); %>
              </ul>
            </div>

            <div class="mt-32">
              <h4 class="heading6">Ubicación</h4>
              <p class="body2 text-secondary mt-8">
                <i class="ph ph-map-pin" style="color:#03a7ff;"></i>
                <%= evento.calle %>
              </p>
            </div>
          </div>

          <div class="blog-more-infor mt-32">
            <div class="infor-above flex-between">
              <div class="tags-cloud-block flex-item-center gap-12">
                <div class="body3">Categoría:</div>
                <a class="caption2 pt-8 pb-8 pl-16 pr-16 bg-surface bora-20 hover-button-black" href="/eventos">
                  <%- evento.categoria %>
                </a>
              </div>
              <div class="share-block flex-item-center gap-16">
                <div class="social-media flex-item-center gap-12">
                  <a href="https://www.facebook.com/centrointernacionalcimarc" target="_blank"><i class="icon-facebook"></i></a>
                  <a href="https://www.linkedin.com/company/centro-internacional-cimarc/" target="_blank"><i class="icon-in"></i></a>
                  <a href="https://instagram.com/centro_internacional_cimarc" target="_blank"><i class="icon-insta fs-14"></i></a>
                </div>
              </div>
            </div>
            <div class="mt-32 line-x"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <a class="scroll-to-top-btn" href="#header"><i class="ph-bold ph-caret-up"></i></a>
  <div class="pb-100"></div>
</div>
