<div id="content">
  <div class="slider-sub">
    <div class="bg-img"><img src="/assets/images/banner/cimarc-banner-noticias.png" alt="banner" style="width:100%; height:400px; object-fit:cover;"/></div>
    <div class="container">
      <div class="heading-nav gap-4 mt-32">
        <a class="hover-underline caption1 text-white" href="/">Home</a>
        <i class="ph ph-caret-double-right text-white"></i>
        <div class="caption1 text-white">Blog</div>
      </div>
      <div class="text-nav">
        <div class="heading3 text-white">Blog</div>
        <div class="sub-heading mt-8 text-white fw-400">Artículos y publicaciones sobre conciliación, arbitraje y resolución de conflictos.</div>
      </div>
    </div>
  </div>

  <div class="blog-list mt-100">
    <div class="container">
      <div class="row row-gap-40">
        <div class="col-12 col-lg-8 flex-column row-gap-40">
          <% blogs.forEach(blog => { %>
          <a class="row blog-item row-gap-20 item-filter" href="#!" data-name="tab-one">
            <div class="col-12 col-md-6">
              <div class="bg-img w-100 overflow-hidden bora-16">
                <img class="w-100 display-block" src="/uploads/blogs/<%= blog.imagen %>" alt="<%= blog.titulo %>" style="height:220px; object-fit:cover;"/>
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div class="caption2 pt-4 pb-4 pl-12 pr-12 bg-surface bora-40 display-inline-block"><%- blog.categoria %></div>
              <div class="heading6 mt-8"><%- blog.titulo %></div>
              <div class="date flex-item-center gap-16 mt-8">
                <div class="author caption2 text-secondary">by <span class="text-on-surface"><%= blog.user ? blog.user.email : 'CIMARC' %></span></div>
                <div class="item-date flex-item-center">
                  <i class="ph-bold ph-calendar-blank"></i>
                  <span class="ml-4 caption2"><%= blog.fecha %></span>
                </div>
              </div>
              <div class="body3 text-secondary mt-16 pb-16"><%= blog.descripcion.substring(0, 120) %>...</div>
              <div class="read fw-700 text-underline">Leer más</div>
            </div>
          </a>
          <% }); %>
          <% if(blogs.length === 0) { %>
          <div style="text-align:center; padding:60px; color:#999;">
            <p>No hay artículos publicados aún.</p>
          </div>
          <% } %>
        </div>

        <div class="col-12 col-lg-4 pl-55">
          <div class="cate-block mt-40">
            <div class="heading7">Categorías</div>
            <div class="list-nav mt-16">
              <div class="nav-item bora-8 flex-between p-12 pointer text-button text-secondary active">Conciliación</div>
              <div class="nav-item bora-8 flex-between p-12 pointer text-button text-secondary">Arbitraje</div>
              <div class="nav-item bora-8 flex-between p-12 pointer text-button text-secondary">Legal</div>
              <div class="nav-item bora-8 flex-between p-12 pointer text-button text-secondary">Opinión</div>
            </div>
          </div>
          <div class="recent-post-block mt-40">
            <div class="recent-post-heading heading7">Publicaciones Recientes</div>
            <div class="list-recent-post mt-16">
              <% blogs.slice(0,3).forEach(blog => { %>
              <div class="recent-post-item d-flex item-start gap-16 mt-16">
                <a class="item-img" href="#!">
                  <img src="/uploads/blogs/<%= blog.imagen %>" alt="<%= blog.titulo %>" style="width:80px; height:80px; object-fit:cover; border-radius:8px; flex-shrink:0;">
                </a>
                <div class="item-infor">
                  <div class="item-date flex-item-center">
                    <i class="ph-bold ph-calendar-blank"></i>
                    <span class="ml-4 caption2"><%= blog.fecha %></span>
                  </div>
                  <div class="item-title mt-4"><%= blog.titulo.substring(0,50) %>...</div>
                </div>
              </div>
              <% }); %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <a class="scroll-to-top-btn" href="#header"><i class="ph-bold ph-caret-up"></i></a>
  <div class="pb-100"></div>
</div>
