<div id="content">
  <div class="slider-sub">
    <div class="bg-img"><img src="/assets/images/banner/cimarc-banner-noticias.png" alt="banner" style="width:100%; height:400px; object-fit:cover;"/></div>
    <div class="container">
      <div class="heading-nav gap-4 mt-32">
        <a class="hover-underline caption1 text-white" href="/">Home</a>
        <i class="ph ph-caret-double-right text-white"></i>
        <div class="caption1 text-white">Blog</div>
      </div>
      <div class="text-nav">
        <div class="heading3 text-white">Blog</div>
        <div class="sub-heading mt-8 text-white fw-400">Artículos y publicaciones sobre conciliación, arbitraje y resolución de conflictos.</div>
      </div>
    </div>
  </div>

  <div class="blog-list mt-100">
    <div class="container">
      <div class="row row-gap-40">

        <!-- Lista de blogs -->
        <div class="col-12 col-lg-8 flex-column row-gap-40" id="listaBlogs">
          <% blogs.forEach(blog => { %>
          <a class="row blog-item row-gap-20 blog-filtrable" href="#!" data-categoria="<%= blog.categoria %>">
            <div class="col-12 col-md-6">
              <div class="bg-img w-100 overflow-hidden bora-16">
                <img class="w-100 display-block" src="<%= blog.imagen %>" alt="<%= blog.titulo %>" style="height:220px; object-fit:cover;"/>
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div class="caption2 pt-4 pb-4 pl-12 pr-12 bg-surface bora-40 display-inline-block"><%- blog.categoria %></div>
              <div class="heading6 mt-8"><%- blog.titulo %></div>
              <div class="date flex-item-center gap-16 mt-8">
                <div class="author caption2 text-secondary">by <span class="text-on-surface"><%= blog.user ? blog.user.email : 'CIMARC' %></span></div>
                <div class="item-date flex-item-center">
                  <i class="ph-bold ph-calendar-blank"></i>
                  <span class="ml-4 caption2"><%= blog.fecha %></span>
                </div>
              </div>
              <div class="body3 text-secondary mt-16 pb-16"><%= blog.descripcion.substring(0, 120) %>...</div>
              <div class="read fw-700 text-underline">Leer más</div>
            </div>
          </a>
          <% }); %>

          <div id="sinResultados" style="display:none; text-align:center; padding:60px; color:#999;">
            <i class="ph ph-magnifying-glass" style="font-size:40px; display:block; margin-bottom:12px;"></i>
            No hay artículos en esta categoría.
          </div>
        </div>

        <!-- Sidebar -->
        <div class="col-12 col-lg-4 pl-55">
          <div class="cate-block mt-40">
            <div class="heading7">Categorías</div>
            <div class="list-nav mt-16">
              <div class="nav-item-cat bora-8 flex-between p-12 pointer text-button text-secondary active" data-cat="Todos" onclick="filtrarBlogs(this)">
                Todos <i class="ph-bold ph-caret-right hidden"></i>
              </div>
              <div class="nav-item-cat bora-8 flex-between p-12 pointer text-button text-secondary" data-cat="Conciliación" onclick="filtrarBlogs(this)">
                Conciliación <i class="ph-bold ph-caret-right hidden"></i>
              </div>
              <div class="nav-item-cat bora-8 flex-between p-12 pointer text-button text-secondary" data-cat="Arbitraje" onclick="filtrarBlogs(this)">
                Arbitraje <i class="ph-bold ph-caret-right hidden"></i>
              </div>
              <div class="nav-item-cat bora-8 flex-between p-12 pointer text-button text-secondary" data-cat="Legal" onclick="filtrarBlogs(this)">
                Legal <i class="ph-bold ph-caret-right hidden"></i>
              </div>
            </div>
          </div>

          <div class="recent-post-block mt-40">
            <div class="recent-post-heading heading7">Publicaciones Recientes</div>
            <div class="list-recent-post mt-16">
              <% blogs.slice(0,3).forEach(blog => { %>
              <div class="recent-post-item d-flex item-start gap-16 mt-16">
                <a class="item-img" href="#!">
                  <img src="<%= blog.imagen %>" alt="<%= blog.titulo %>" style="width:80px; height:80px; object-fit:cover; border-radius:8px; flex-shrink:0;">
                </a>
                <div class="item-infor">
                  <div class="item-date flex-item-center">
                    <i class="ph-bold ph-calendar-blank"></i>
                    <span class="ml-4 caption2"><%= blog.fecha %></span>
                  </div>
                  <div class="item-title mt-4"><%= blog.titulo.substring(0,50) %>...</div>
                </div>
              </div>
              <% }); %>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
  <a class="scroll-to-top-btn" href="#header"><i class="ph-bold ph-caret-up"></i></a>
  <div class="pb-100"></div>
</div>

<style>
  .nav-item-cat { cursor: pointer; transition: .2s; }
  .nav-item-cat:hover { background: #f0f4f8; }
  .nav-item-cat.active { background: #e8f4ff; color: #03a7ff; font-weight: 700; }
  .blog-filtrable { transition: opacity .25s; }
</style>

<script>
function filtrarBlogs(navEl) {
  document.querySelectorAll('.nav-item-cat').forEach(n => n.classList.remove('active'));
  navEl.classList.add('active');

  const cat = navEl.getAttribute('data-cat');
  const items = document.querySelectorAll('.blog-filtrable');
  let visibles = 0;

  items.forEach(function(item) {
    const coincide = cat === 'Todos' || item.getAttribute('data-categoria') === cat;
    item.style.display = coincide ? '' : 'none';
    if (coincide) visibles++;
  });

  document.getElementById('sinResultados').style.display = visibles === 0 ? 'block' : 'none';
}
</script>
