<div class="content">

  <!-- Header -->
  <div style="margin-bottom:28px;">
    <h2 style="margin:0 0 4px; font-size:24px; color:#1a1a2e;">Panel del Trabajador</h2>
    <small style="color:#888;">Bienvenido al sistema de gestión CIMARC</small>
  </div>

  <!-- Tarjetas de acceso rápido -->
  <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:28px;">
    <div style="background:white; border-radius:12px; padding:24px; box-shadow:0 2px 8px rgba(0,0,0,.08);">
      <div style="display:flex; align-items:center; gap:14px; margin-bottom:16px;">
        <div style="background:#e8f4ff; border-radius:10px; padding:14px;">
          <i class="fa-solid fa-folder-open" style="color:#03a7ff; font-size:22px;"></i>
        </div>
        <div>
          <div style="color:#888; font-size:13px;">Casos</div>
          <div style="font-size:22px; font-weight:700; color:#1a1a2e;">Historial</div>
        </div>
      </div>
      <a href="" style="color:#03a7ff; font-size:13px; font-weight:600; text-decoration:none;">
        Ver casos asignados <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>

    <div style="background:white; border-radius:12px; padding:24px; box-shadow:0 2px 8px rgba(0,0,0,.08);">
      <div style="display:flex; align-items:center; gap:14px; margin-bottom:16px;">
        <div style="background:#e8faf0; border-radius:10px; padding:14px;">
          <i class="fa-solid fa-dollar-sign" style="color:#27ae60; font-size:22px;"></i>
        </div>
        <div>
          <div style="color:#888; font-size:13px;">Pagos</div>
          <div style="font-size:22px; font-weight:700; color:#1a1a2e;">Registro</div>
        </div>
      </div>
      <a href="/trabajador/pagoRegister" style="color:#27ae60; font-size:13px; font-weight:600; text-decoration:none;">
        Registrar un pago <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>

    <div style="background:white; border-radius:12px; padding:24px; box-shadow:0 2px 8px rgba(0,0,0,.08);">
      <div style="display:flex; align-items:center; gap:14px; margin-bottom:16px;">
        <div style="background:#fff8e1; border-radius:10px; padding:14px;">
          <i class="fa-solid fa-clock" style="color:#f39c12; font-size:22px;"></i>
        </div>
        <div>
          <div style="color:#888; font-size:13px;">Hora actual</div>
          <div style="font-size:22px; font-weight:700; color:#1a1a2e;" id="reloj">--:--:--</div>
        </div>
      </div>
      <a href="/cerrar-sesion" style="color:#e74c3c; font-size:13px; font-weight:600; text-decoration:none;">
        Cerrar sesión <i class="fa-solid fa-right-from-bracket"></i>
      </a>
    </div>
  </div>

  <!-- Aviso informativo -->
  <div style="background:white; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,.08); padding:48px; text-align:center; color:#aaa;">
    <i class="fa-solid fa-hand-point-left" style="font-size:40px; margin-bottom:16px; display:block; color:#03a7ff; opacity:.5;"></i>
    <p style="margin:0; font-size:15px;">Selecciona una opción del menú lateral para comenzar.</p>
  </div>
</div>

<script>
  function actualizarReloj() {
    document.getElementById('reloj').textContent = new Date().toLocaleTimeString('es-PE');
  }
  actualizarReloj();
  setInterval(actualizarReloj, 1000);
</script>
