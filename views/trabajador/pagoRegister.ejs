<div class="content">
  <div class="page-header">
    <div>
      <h2>Registrar Pago</h2>
      <small>Ingresa los datos del pago a registrar</small>
    </div>
    <a href="/trabajador/home" class="btn-secondary-panel">
      <i class="fa-solid fa-arrow-left"></i> Regresar
    </a>
  </div>

  <div class="panel-card" style="max-width:620px;">
    <div class="panel-card-header">
      <h5><i class="fa-solid fa-dollar-sign" style="color:#27ae60; margin-right:8px;"></i>Datos del Pago</h5>
    </div>
    <div class="panel-card-body">
      <form action="/pagos" method="POST">
        <div class="form-group">
          <label>Datos del Trabajador</label>
          <input type="text" name="DatosTrabajador" required placeholder="Nombre completo">
        </div>
        <div class="form-group">
          <label>Cargo</label>
          <select name="Cargo" required>
            <option value="">Seleccionar cargo...</option>
            <option value="Conciliador">Conciliador</option>
            <option value="Árbitro">Árbitro</option>
            <option value="Asistente">Asistente</option>
          </select>
        </div>
        <div class="form-group">
          <label>Fecha</label>
          <input type="date" name="Fecha" required>
        </div>
        <div class="form-group">
          <label>Descripción</label>
          <textarea name="Descripcion" rows="3" required placeholder="Detalle del pago..."></textarea>
        </div>
        <div class="form-group">
          <label>Monto (S/.)</label>
          <input type="number" name="Monto" required placeholder="0.00" step="0.01" min="0">
        </div>
        <button type="submit" class="btn-primary-panel" style="width:100%; justify-content:center; padding:13px; background:#27ae60;">
          <i class="fa-solid fa-check"></i> Registrar Pago
        </button>
      </form>
    </div>
  </div>
</div>
